# ── Hermes OS · configuración por máquina ─────────────────────────────────
# Copia este archivo a .env en la RAÍZ del monorepo y completa los valores.
# El agent server, los scripts y Next.js leen ese mismo archivo.
#
# Mínimo para arrancar (lo demás es opcional y degrada solo):
#   HERMES_OWNER_NAME · MACHINE_NAME · HERMES_API_KEY · los 3 de Supabase.
# Claude NO necesita API key: el Agent SDK usa el login de Claude Code de esta
# máquina (suscripción Pro/Max/Team). Ver README → "Cómo consume Claude".

# ── Identidad del dueño ───────────────────────────────────────────────────
# Nombre con el que Hermes se dirige a ti (prompts del agente y de la voz).
# Default: tu usuario del sistema, capitalizado.
HERMES_OWNER_NAME=
# El mismo nombre para la UI (saludo del dashboard, prompts de scope de voz).
NEXT_PUBLIC_HERMES_OWNER_NAME=
# Persona y preferencias en markdown, FUERA del repo (plantilla en
# docs/SOUL.example.md). Se inyecta al system prompt y a los prompts
# especializados por sección ("## Creador de contenido", "## Inglés"…).
# HERMES_SOUL_PATH=~/.hermes-os/SOUL.md

# ── Máquina local ─────────────────────────────────────────────────────────
# Nombre ÚNICO de esta máquina (PK de agent_presence: dos agentes con el mismo
# nombre se pisan el heartbeat).
MACHINE_NAME=
# Vault de Obsidian (fuente de verdad de proyectos). Vacío = máquina SOLO
# EJECUCIÓN: los proyectos se leen del espejo de Supabase y no se escriben notas.
VAULT_PATH=
# Raíz de los clones de código en esta máquina (default: ~/dev). Los runs
# buscan el repo del proyecto aquí por nombre (también un nivel adentro).
# HERMES_CODE_ROOT=/Users/<usuario>/dev
# Importación única de memorias desde un clawd previo (opcional).
# CLAWD_PATH=

# ── Agent server ──────────────────────────────────────────────────────────
HERMES_PORT=8650
# Bearer del agente. SIN key escucha SOLO en 127.0.0.1; CON key se abre a la
# red (0.0.0.0) y exige auth — es el interruptor del modo multi-máquina y del
# acceso móvil. Genera uno: openssl rand -hex 24
HERMES_API_KEY=
# La key va también al browser, que la manda como Bearer (y ?key= en los SSE):
# NEXT_PUBLIC_HERMES_API_KEY=
# URL que usa el browser para hablar con el agent server
NEXT_PUBLIC_HERMES_URL=http://localhost:8650
# Modelo del agente (alias del CLI: sonnet | opus | haiku). Vacío = default del CLI.
# HERMES_MODEL=
# Notificaciones nativas de macOS al terminar runs/tareas (0 = apagadas)
# HERMES_NOTIFY=1

# ── Supabase (memoria, tareas, juntas, presencia; pgvector) ───────────────
# Proyecto propio + migraciones de supabase/migrations/ en orden (README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (SOLO embeddings para la búsqueda semántica; opcional) ─────────
# Sin key el agente funciona, pero match_knowledge no indexa ni busca.
OPENAI_API_KEY=

# ── Anthropic — NO configurar ─────────────────────────────────────────────
# El Agent SDK spawnea el CLI `claude` y usa su login (suscripción). Si esta
# variable existe en el entorno, el CLI la prefiere y COBRA POR API.
# ANTHROPIC_API_KEY=

# ── ElevenLabs (voz en tiempo real; opcional) ─────────────────────────────
ELEVENLABS_API_KEY=
# Se genera con: pnpm setup:elevenlabs (crea/actualiza el agente y devuelve el ID)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Voz del agente (id de tu biblioteca de ElevenLabs; default: una voz pública)
# ELEVENLABS_VOICE_ID=
# Velocidad del TTS (0.7–1.2)
# ELEVENLABS_VOICE_SPEED=1.0
# LLM router del agente de voz (enum de ElevenLabs).
ELEVENLABS_AGENT_LLM=claude-haiku-4-5
# Tutor de inglés (segundo agente ElevenLabs; lo crea el mismo setup:elevenlabs)
NEXT_PUBLIC_ELEVENLABS_TUTOR_AGENT_ID=
# ELEVENLABS_TUTOR_VOICE_ID=cgSgspJ2msm6clMCkdW9   # default: Jessica
# ELEVENLABS_TUTOR_LLM=claude-sonnet-4-5

# ── Reuniones ─────────────────────────────────────────────────────────────
# Transcripción batch de grabaciones (default: el motor local del ingest).
# HERMES_STT=
# AssemblyAI — junta EN VIVO (transcript streaming + diarización del copiloto).
# Sin esta key el botón "Iniciar junta en vivo" muestra el CTA de configuración.
ASSEMBLYAI_API_KEY=
# Provider del STT en vivo: assemblyai (default) | fake (guion de prueba, sin gastar)
# HERMES_LIVE_STT=assemblyai
# HERMES_LIVE_STT_SCRIPT=interview
# Capa RÁPIDA del copiloto de juntas (corre con la suscripción de Claude Code):
# vacío = activada · fake = respuesta enlatada (e2e sin gastar) · off = desactivada
# HERMES_COPILOT=
# HERMES_COPILOT_MODEL=claude-haiku-4-5

# ── Control del sistema (macOS) ───────────────────────────────────────────
# Control por gestos (webcam → cursor del sistema): activado por default.
# "off" apaga las rutas /input/gestures. Requiere permiso de Accessibility
# para el node del LaunchAgent (Ajustes → Privacidad y seguridad → Accesibilidad).
# HERMES_GESTURES=
# Navegación web agéntica por voz (browse_web → chrome-devtools-mcp sobre un
# Chrome CDP dedicado con perfil ~/.hermes-os/chrome-hermes): activada por
# default. "off" no registra el MCP ni expone /browser/navigate.
# HERMES_BROWSER_AGENT=
# HERMES_BROWSER_CDP_PORT=9222
# Tira de luces TP-Link Kasa (protocolo IOT legacy :9999, solo LAN). Vacío =
# luces no configuradas. Requiere `uv tool install python-kasa` (binario en
# ~/.local/bin/kasa; override KASA_BIN).
# HERMES_LIGHTS_HOST=192.168.1.50
# KASA_BIN=/Users/<usuario>/.local/bin/kasa

# ── Acceso remoto (app móvil): túnel + login ──────────────────────────────
# El servicio com.hermes-os.tunnel (./hermes install) expone el agente con un
# quick tunnel de cloudflared y publica la URL en Supabase (remote_config).
# La app móvil entra con email+contraseña (Supabase Auth): el agente acepta
# ese JWT además de la HERMES_API_KEY. Crea el usuario en el dashboard de
# Supabase (Authentication → Users). Solo documentación, no lo lee código:
# HERMES_MOBILE_USER=
# HERMES_MOBILE_PASSWORD=

# ── Multi-máquina en la red interna (varios PCs, un solo dashboard) ───────
# Guía completa: docs/multi-maquina.md
# El dashboard lo sirve UNA máquina y CADA máquina corre su propio agente con
# su propio MACHINE_NAME. La MISMA HERMES_API_KEY y el MISMO Supabase en todas
# — así comparten memoria, presencia y proyectos.
#
# Cómo alcanzan los OTROS PCs a este agente. Vacío = se deriva de la IP LAN
# real. A mano solo con nombre/puerto distinto (Tailscale, reverse proxy):
# HERMES_PUBLIC_URL=http://192.168.1.10:8650
# Registry manual del selector ("nombre=url" separadas por |). Solo bootstrap:
# cada agente publica su URL en el heartbeat.
# NEXT_PUBLIC_HERMES_AGENTS=mac=http://192.168.1.10:8650|pc=http://192.168.1.11:8650

# ── Dashboard: calendario y clima ─────────────────────────────────────────
# Dirección SECRETA iCal de Google Calendar (Ajustes → tu calendario →
# "Dirección secreta en formato iCal"). Quien tenga esta URL ve tus eventos:
# trátala como una contraseña. Sin ella, el panel muestra el CTA.
# GOOGLE_CALENDAR_ICS_URL=
#
# Google Calendar API — ESCRITURA por voz (crear/mover/borrar eventos). OAuth2:
#  1) Google Cloud Console → nuevo proyecto → habilita "Google Calendar API".
#  2) Pantalla de consentimiento OAuth (External, Testing) con tu correo.
#  3) Credenciales → "ID de cliente OAuth" tipo "Aplicación web" con el
#     redirect URI  http://localhost:8788/oauth2callback  → copia id y secret.
#  4) pnpm --filter @hermes/agent google:auth → autoriza y pega el refresh token.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TZ=America/Bogota
# GOOGLE_OAUTH_PORT=8788
#
# Clima (Open-Meteo, sin API key). Defaults: Bogotá.
# WEATHER_LAT=4.7110
# WEATHER_LON=-74.0721
# WEATHER_PLACE=Bogotá

# ── Panel "Límites de uso del plan" ───────────────────────────────────────
# Lee el endpoint OAuth de uso de tu suscripción (solo lectura). El token se
# resuelve: CLAUDE_OAUTH_TOKEN → ~/.hermes-os/claude-token (lo escribe
# `pnpm --filter @hermes/web usage:token <token>`) → Keychain (opt-in).
# CLAUDE_OAUTH_TOKEN=
# CLAUDE_USAGE_KEYCHAIN=1
# CLAUDE_PLAN=

# ── Linear (manejo de tareas; opcional) ───────────────────────────────────
# Personal API key: Linear → Settings → Security & access → Personal API keys.
# Hermes crea issues con contexto + bloque "Copy prompt" y conecta el MCP
# oficial (mcp.linear.app) con la misma key. Sin key, las tools muestran el CTA.
# LINEAR_API_KEY=
# LINEAR_TEAM_KEY=

# ── Grafo de código (graphify; opcional) ──────────────────────────────────
# uv tool install "graphifyy[sql,openai]" → binario en ~/.local/bin. Ruta
# absoluta porque launchd corre con PATH mínimo.
# GRAPHIFY_BIN=/Users/<usuario>/.local/bin/graphify
# CODE_GRAPH_ROOT=

# ── Estudio: edición automática y material ────────────────────────────────
# Repo local de OpenMontage (agent-first). Default: ~/dev/video-edit.
# VIDEO_EDIT_PATH=
# Carpeta madre del material (p.ej. disco extraíble): cada pieza vive en
# <root>/<slug>/{crudos,assets,exports}. Vacío = sin disco; la captura cae a
# ~/Movies/estudio.
# ESTUDIO_MEDIA_ROOT=/Volumes/<disco>/estudio
