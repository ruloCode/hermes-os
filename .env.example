# ── Hermes OS · configuración por máquina ─────────────────────────────
# Copia este archivo a .env (raíz del repo) y completa los valores.
# El agent server y los scripts leen la raíz; Next.js también la lee vía dotenv.

# ElevenLabs (voz en tiempo real)
ELEVENLABS_API_KEY=
# Se genera con: pnpm setup:elevenlabs (crea/actualiza el agente y devuelve el ID)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Voz clonada "Rulo Voz"
ELEVENLABS_VOICE_ID=NoS5MJPorMp1e5EcDXzn
# LLM router del agente de voz (verificado en la doc de ElevenLabs).
# Sólo cámbialo si ElevenLabs actualiza el enum: claude-opus-4-7, claude-sonnet-4-6, etc.
ELEVENLABS_AGENT_LLM=claude-haiku-4-5

# Supabase (memoria compartida entre máquinas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (solo embeddings para búsqueda semántica de memorias)
OPENAI_API_KEY=

# Máquina local
VAULT_PATH="/Users/rulocode/Documents/Obsidian Vault"
CLAWD_PATH=/Users/rulocode/dev/side/clawd
MACHINE_NAME=macbook-main

# Agent server
HERMES_PORT=8642
# Bearer opcional. SIN key el agente escucha SOLO en 127.0.0.1; CON key se
# abre a la red (0.0.0.0) y exige auth — es el interruptor del modo multi-Mac.
HERMES_API_KEY=
# URL que usa el browser para hablar con el agent server
NEXT_PUBLIC_HERMES_URL=http://localhost:8642
# Notificaciones nativas de macOS al terminar runs/tareas (0 = apagadas)
# HERMES_NOTIFY=1

# ── Multi-Mac (Tailscale) ────────────────────────────────────────────────
# La MISMA HERMES_API_KEY va en el .env de todas las Macs. El dashboard la
# manda como Bearer (y ?key= en SSE):
# NEXT_PUBLIC_HERMES_API_KEY=
# Selector de máquina del header: "nombre=url" separadas por |. Sin esta env
# el selector no aparece (setup de una sola Mac).
# NEXT_PUBLIC_HERMES_AGENTS=mini=http://100.x.y.z:8650|portatil=http://localhost:8650

# Anthropic — OPCIONAL. Si esta máquina está logueada en Claude Code,
# el Agent SDK usa esas credenciales automáticamente.
# ANTHROPIC_API_KEY=

# ── Panel "Límites de uso del plan" (Sesión actual) ──────────────────────
# Consume el endpoint OAuth de uso de tu suscripción en solo-lectura. El token
# se resuelve en este orden: CLAUDE_OAUTH_TOKEN → ~/.hermes/claude-token
# (lo escribe `pnpm --filter @hermes/web usage:token <token>`) → Keychain.
# El tier del plan ("Max (20x)") se autodetecta de ~/.claude.json; CLAUDE_PLAN
# solo hace falta como override manual.
# CLAUDE_OAUTH_TOKEN=
# CLAUDE_USAGE_KEYCHAIN=1        # leer el token del Keychain de Claude Code (macOS)
# CLAUDE_PLAN=
