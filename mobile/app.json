{
  "expo": {
    "name": "Hermes",
    "slug": "mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hermes",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070c",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rulocode.hermes",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hermes usa el micrófono para hablar por voz en tiempo real y grabar reuniones.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.rulocode.hermes",
      "adaptiveIcon": {
        "backgroundColor": "#07070c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-audio",
        {
          "microphonePermission": "Hermes usa el micrófono para hablar por voz y grabar reuniones.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
