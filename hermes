#!/usr/bin/env bash
#
# hermes — lanzador de Hermes OS
#
# Uso:
#   ./hermes            arranca web + agente (equivale a `pnpm dev`)
#   ./hermes web        solo el dashboard (Next.js)
#   ./hermes agent      solo el agent server (Claude Agent SDK)
#   ./hermes setup      instala deps, crea .env y prepara ElevenLabs
#   ./hermes doctor     revisa requisitos y puertos sin arrancar nada
#   ./hermes stop       mata lo que esté escuchando en los puertos de Hermes
#   ./hermes typecheck  typecheck de todos los paquetes
#   ./hermes help       esta ayuda
#
set -euo pipefail

# --- ubicación: siempre corre desde la raíz del repo ---
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# --- colores ---
if [[ -t 1 ]]; then
  B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
  CYAN=$'\033[36m'; MAG=$'\033[35m'; GREEN=$'\033[32m'; YEL=$'\033[33m'; RED=$'\033[31m'
else
  B=""; DIM=""; R=""; CYAN=""; MAG=""; GREEN=""; YEL=""; RED=""
fi

say()  { printf "%s\n" "$*"; }
ok()   { printf "  ${GREEN}✓${R} %s\n" "$*"; }
warn() { printf "  ${YEL}!${R} %s\n" "$*"; }
err()  { printf "  ${RED}✗${R} %s\n" "$*" >&2; }

banner() {
  printf "\n${B}${CYAN}⚡ Hermes OS${R} ${DIM}— %s${R}\n\n" "${1:-lanzador}"
}

# --- lee un valor del .env (sin exportar todo el archivo) ---
env_get() {
  local key="$1" file="${2:-.env}"
  [[ -f "$file" ]] || return 0
  grep -E "^[[:space:]]*${key}=" "$file" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs 2>/dev/null || true
}

WEB_PORT="$(env_get NEXT_PUBLIC_WEB_PORT)"; WEB_PORT="${WEB_PORT:-31415}"
AGENT_PORT="$(env_get HERMES_PORT)"; AGENT_PORT="${AGENT_PORT:-8642}"
# Los scripts de web usan ${NEXT_PUBLIC_WEB_PORT:-31415} → exportarlo hace
# que cambiar el puerto en .env tenga efecto real.
export NEXT_PUBLIC_WEB_PORT="$WEB_PORT"

port_pid() { { lsof -i ":$1" -sTCP:LISTEN -t 2>/dev/null || true; } | head -n1; }

# --- verificaciones de entorno ---
need_cmd() {
  if command -v "$1" >/dev/null 2>&1; then ok "$1 $(${1} --version 2>/dev/null | head -n1 | tr -d '\n' | sed 's/^v//' || true)"; return 0
  else err "$1 no encontrado — $2"; return 1; fi
}

check_deps() {
  local missing=0
  need_cmd node "instala Node 22+ (https://nodejs.org)"   || missing=1
  need_cmd pnpm "corre: npm i -g pnpm"                     || missing=1
  if command -v rg >/dev/null 2>&1; then ok "ripgrep"; else warn "ripgrep (rg) falta — brew install ripgrep (lo usa el agente)"; fi
  return $missing
}

ensure_env() {
  if [[ ! -f .env ]]; then
    if [[ -f .env.example ]]; then
      cp .env.example .env
      warn ".env no existía → lo copié de .env.example. Complétalo antes de usar voz/Supabase."
    else
      err "No hay .env ni .env.example."
      return 1
    fi
  else
    ok ".env presente"
  fi
}

ensure_install() {
  if [[ ! -d node_modules/.bin ]] || [[ ! -x node_modules/.bin/concurrently ]]; then
    say "  ${DIM}Instalando dependencias (pnpm install)…${R}"
    pnpm install
  else
    ok "dependencias instaladas"
  fi
}

preflight() {
  check_deps || { err "Faltan requisitos. Corré: ${B}./hermes doctor${R}"; exit 1; }
  ensure_env
  ensure_install
}

# --- subcomandos ---
cmd_doctor() {
  banner "doctor"
  check_deps || true
  ensure_env || true
  echo
  say "  ${B}Puertos${R}"
  local wp ap
  wp="$(port_pid "$WEB_PORT")"; ap="$(port_pid "$AGENT_PORT")"
  [[ -n "$wp" ]] && warn "web :$WEB_PORT ocupado (pid $wp)"     || ok "web :$WEB_PORT libre"
  [[ -n "$ap" ]] && warn "agente :$AGENT_PORT ocupado (pid $ap)" || ok "agente :$AGENT_PORT libre"
  echo
  say "  ${B}Autostart (launchd)${R}"
  local l
  for l in "$PLIST_AGENT" "$PLIST_WEB" "$PLIST_OPEN" "$PLIST_TUNNEL"; do
    if svc_loaded "$l"; then ok "$l cargado"; else warn "$l no cargado ${DIM}(./hermes install)${R}"; fi
  done
  local tun_host
  tun_host="$(curl -sf --max-time 2 "http://127.0.0.1:8654/quicktunnel" 2>/dev/null | sed -E 's/.*"hostname":"([^"]*)".*/\1/')"
  if [[ -n "$tun_host" ]]; then ok "túnel público: https://$tun_host"; else warn "túnel cloudflared no responde (app móvil solo por LAN)"; fi
  echo
  say "  ${B}Salud${R}"
  if curl -sf -o /dev/null --max-time 2 "http://localhost:$AGENT_PORT/health"; then
    ok "agente responde /health"
  else
    warn "agente :$AGENT_PORT no responde"
  fi
  if curl -sf -o /dev/null --max-time 2 "http://localhost:$WEB_PORT"; then
    ok "dashboard responde"
  else
    warn "dashboard :$WEB_PORT no responde"
  fi
  echo
  say "  ${B}Disco${R}"
  local free_gb; free_gb="$(df -g /System/Volumes/Data 2>/dev/null | awk 'NR==2 {print $4}')"
  if [[ -n "$free_gb" ]]; then
    if [[ "$free_gb" -lt 20 ]]; then warn "solo ${free_gb} GB libres — corre ~/bin/disk-cleanup.sh"; else ok "${free_gb} GB libres en el interno"; fi
  fi
  if [[ -d /Volumes/Rulo ]]; then ok "disco externo Rulo montado"; else warn "disco externo Rulo NO montado (archive/restore no disponibles)"; fi
  echo
}

cmd_stop() {
  banner "stop"
  # Si el autostart está cargado, matar el pid no sirve (KeepAlive lo revive):
  # hay que descargar el servicio de launchd.
  local l
  for l in "$PLIST_AGENT" "$PLIST_WEB" "$PLIST_TUNNEL"; do
    if svc_loaded "$l" 2>/dev/null; then
      launchctl bootout "gui/$(id -u)/$l" 2>/dev/null || true
      ok "servicio $l descargado (vuelve al próximo login o con ./hermes install)"
    fi
  done
  local killed=0
  for p in "$WEB_PORT" "$AGENT_PORT"; do
    local pid; pid="$(port_pid "$p")"
    if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null && ok "maté pid $pid en :$p" && killed=1; fi
  done
  [[ "$killed" -eq 0 ]] && ok "no había nada escuchando en :$WEB_PORT ni :$AGENT_PORT"
  return 0
}

cmd_setup() {
  banner "setup"
  preflight
  echo
  say "  ${DIM}Configurando agente de voz ElevenLabs…${R}"
  if pnpm setup:elevenlabs; then
    ok "ElevenLabs listo — pega el NEXT_PUBLIC_ELEVENLABS_AGENT_ID que imprimió en .env"
  else
    warn "setup:elevenlabs falló (¿faltan claves en .env?). El resto quedó instalado."
  fi
}

cmd_typecheck() { banner "typecheck"; pnpm typecheck; }

# --- producción: launchd (autostart al login) ---------------------------
LA_DIR="$HOME/Library/LaunchAgents"
LOG_DIR="$HOME/.hermes-os/logs"
PLIST_AGENT="com.hermes-os.agent"
PLIST_WEB="com.hermes-os.web"
PLIST_OPEN="com.hermes-os.open"
PLIST_TUNNEL="com.hermes-os.tunnel"

# PATH para launchd (mínimo por defecto): node/pnpm reales + homebrew + claude.
launchd_path() {
  local paths=""
  for bin in node pnpm claude; do
    local p; p="$(command -v "$bin" 2>/dev/null || true)"
    [[ -n "$p" ]] && paths="$paths:$(dirname "$p")"
  done
  printf "%s" "${paths#:}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

write_plist() {
  local label="$1"; shift
  local keepalive="$1"; shift
  local logname="$1"; shift
  local file="$LA_DIR/$label.plist"
  {
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$label</string>
    <key>WorkingDirectory</key><string>$ROOT</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$(launchd_path)</string>
        <key>HOME</key><string>$HOME</string>
    </dict>
    <key>RunAtLoad</key><true/>
PLIST
    if [[ "$keepalive" == "yes" ]]; then
      printf '    <key>KeepAlive</key><true/>\n    <key>ThrottleInterval</key><integer>10</integer>\n'
    fi
    cat <<PLIST
    <key>StandardOutPath</key><string>$LOG_DIR/$logname.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/$logname.err.log</string>
    <key>ProgramArguments</key>
    <array>
PLIST
    local arg
    for arg in "$@"; do printf '        <string>%s</string>\n' "$arg"; done
    cat <<'PLIST'
    </array>
</dict>
</plist>
PLIST
  } > "$file"
  ok "plist: $file"
}

svc_loaded() { launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1; }

svc_bootout() {
  if svc_loaded "$1"; then
    launchctl bootout "gui/$(id -u)/$1" 2>/dev/null || true
    ok "descargado $1"
  fi
}

cmd_install() {
  banner "install — Hermes de producción al login"
  preflight
  mkdir -p "$LOG_DIR"
  local pnpm_bin; pnpm_bin="$(command -v pnpm)"

  say "  ${DIM}Compilando build de producción (pnpm build)…${R}"
  pnpm build

  # Baja lo que esté corriendo (dev o instalación anterior) antes de instalar.
  svc_bootout "$PLIST_AGENT"; svc_bootout "$PLIST_WEB"; svc_bootout "$PLIST_OPEN"; svc_bootout "$PLIST_TUNNEL"
  cmd_stop >/dev/null

  write_plist "$PLIST_AGENT"  yes agent  "$pnpm_bin" --filter @hermes/agent start
  write_plist "$PLIST_WEB"    yes web    "$pnpm_bin" --filter @hermes/web start
  write_plist "$PLIST_OPEN"   no  open   /bin/bash "$ROOT/scripts/hermes-open.sh"
  write_plist "$PLIST_TUNNEL" yes tunnel /bin/bash "$ROOT/scripts/hermes-tunnel.sh"

  local u; u="$(id -u)"
  launchctl bootstrap "gui/$u" "$LA_DIR/$PLIST_AGENT.plist"  && ok "agente arriba (:$AGENT_PORT)"
  launchctl bootstrap "gui/$u" "$LA_DIR/$PLIST_WEB.plist"    && ok "web arriba (:$WEB_PORT)"
  launchctl bootstrap "gui/$u" "$LA_DIR/$PLIST_OPEN.plist"   && ok "dashboard se abrirá al estar sano"
  launchctl bootstrap "gui/$u" "$LA_DIR/$PLIST_TUNNEL.plist" && ok "túnel público del agente (URL en Supabase remote_config)"
  echo
  say "  ${GREEN}Listo:${R} Hermes arranca solo en cada login."
  say "  ${DIM}Logs: $LOG_DIR · Para desarrollo: ./hermes uninstall && ./hermes dev${R}"
}

cmd_uninstall() {
  banner "uninstall — quitar autostart"
  svc_bootout "$PLIST_AGENT"; svc_bootout "$PLIST_WEB"; svc_bootout "$PLIST_OPEN"; svc_bootout "$PLIST_TUNNEL"
  local l
  for l in "$PLIST_AGENT" "$PLIST_WEB" "$PLIST_OPEN" "$PLIST_TUNNEL"; do
    [[ -f "$LA_DIR/$l.plist" ]] && rm "$LA_DIR/$l.plist" && ok "borrado $l.plist"
  done
  ok "autostart retirado (el código no se toca)"
}

start_urls() {
  printf "\n"
  printf "  ${B}${CYAN}▸ Dashboard${R}  http://localhost:%s\n" "$WEB_PORT"
  printf "  ${B}${MAG}▸ Agente${R}     http://localhost:%s\n" "$AGENT_PORT"
  printf "  ${DIM}Ctrl-C para parar todo${R}\n\n"
}

warn_busy() {
  local pid
  pid="$(port_pid "$1")"
  if [[ -n "$pid" ]]; then
    warn ":$1 ya está ocupado (pid $pid) — quizá otro Hermes. Usá ${B}./hermes stop${R} o cambiá el puerto."
  fi
  return 0
}

cmd_all() {
  banner "arrancando web + agente"
  preflight
  warn_busy "$WEB_PORT"; warn_busy "$AGENT_PORT"
  start_urls
  exec pnpm dev
}

cmd_web() {
  banner "solo dashboard"
  preflight
  warn_busy "$WEB_PORT"
  printf "\n  ${B}${CYAN}▸ Dashboard${R}  http://localhost:%s  ${DIM}(Ctrl-C para parar)${R}\n\n" "$WEB_PORT"
  exec pnpm dev:web
}

cmd_agent() {
  banner "solo agente"
  preflight
  warn_busy "$AGENT_PORT"
  printf "\n  ${B}${MAG}▸ Agente${R}  http://localhost:%s  ${DIM}(Ctrl-C para parar)${R}\n\n" "$AGENT_PORT"
  exec pnpm dev:agent
}

cmd_help() {
  banner "lanzador"
  cat <<EOF
  ${B}Uso:${R} ./hermes ${DIM}[comando]${R}

    ${B}(sin args)${R}   arranca web + agente (dev)  ${DIM}pnpm dev${R}
    ${B}web${R}          solo el dashboard           ${DIM}:$WEB_PORT${R}
    ${B}agent${R}        solo el agent server        ${DIM}:$AGENT_PORT${R}
    ${B}install${R}      build de producción + autostart al login (launchd)
    ${B}uninstall${R}    quita el autostart (no toca el código)
    ${B}setup${R}        instala deps + ElevenLabs
    ${B}doctor${R}       requisitos, puertos, autostart, salud y disco
    ${B}stop${R}         para los servicios / libera los puertos
    ${B}typecheck${R}    typecheck de todo el monorepo
    ${B}help${R}         esta ayuda

  Tip: agregá el repo al PATH y escribí ${B}hermes${R} desde donde sea.
EOF
}

case "${1:-}" in
  ""|start|dev|all) cmd_all ;;
  web)              cmd_web ;;
  agent)            cmd_agent ;;
  install)          cmd_install ;;
  uninstall)        cmd_uninstall ;;
  setup)            cmd_setup ;;
  doctor)           cmd_doctor ;;
  stop)             cmd_stop ;;
  typecheck|tc)     cmd_typecheck ;;
  help|-h|--help)   cmd_help ;;
  *) err "Comando desconocido: $1"; echo; cmd_help; exit 1 ;;
esac
